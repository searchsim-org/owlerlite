# OwlerLite Root Environment Configuration
# This file is read by docker-compose for all services
# Copy to .env and fill in your API keys:
#   cp .env.example .env

# === OpenAI API Configuration ===
# Used by Crawler (SemDeDup) and Orchestrator (NL Rationale)
EMBEDDING_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=changeme

LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=changeme
LLM_MODEL=gpt-4o-mini

# === Crawler: SemDeDup Configuration ===
# Set to 'true' to use LightRAG's embedder instead of direct API calls
USE_LIGHTRAG_EMBED=false

# === Orchestrator: Scoring Weights ===
# Per paper formula: h(q,p) = α·sim + (1-α)·graph + β·log(g) + δ·fresh
RAG_ALPHA=0.8    # Weight for vector similarity vs graph score
RAG_BETA=0.2     # Weight for scope prior log term
RAG_DELTA=0.15   # Weight for freshness
RAG_GAMMA=0.1    # Scope prior value for out-of-scope documents
